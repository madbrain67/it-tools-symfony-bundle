{
    "name": "plateformweb/it-tools-symfony-bundle",
    "description": "Bundle Symfony pour l'API IT-Tools : client autowirable, configuration YAML, transport Symfony HttpClient et commande de diagnostic.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "it-tools", "api", "sdk"],
    "require": {
        "php": ">=8.1",
        "plateformweb/it-tools-php": "^1.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-client": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/mime": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/framework-bundle": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Plateformweb\\ItToolsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plateformweb\\ItToolsBundle\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {"symlink": false, "versions": {"plateformweb/it-tools-php": "1.0.0"}}
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
